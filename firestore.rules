rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Profile, points and saved stations belong to the owner.
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;

      // Why points changed. Append-only from the app; awards themselves
      // must move server-side before points can be redeemed.
      match /points_ledger/{entryId} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow create: if isSignedIn() && request.auth.uid == uid
                      && request.resource.data.points is int
                      && request.resource.data.points >= -50
                      && request.resource.data.points <= 50;
        allow update, delete: if false;
      }

      // Fill-up log, synced across the owner's devices.
      match /fill_ups/{fillUpId} {
        allow read, delete: if isSignedIn() && request.auth.uid == uid;
        allow create, update: if isSignedIn() && request.auth.uid == uid
                              && request.resource.data.amountSpent is number
                              && request.resource.data.amountSpent > 0
                              && request.resource.data.odometerKm is number
                              && request.resource.data.timestamp is string;
      }
    }

    // Crowdsourced prices: anyone signed in can read and contribute.
    match /stations/{stationId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    // Users create their own reports and can only read their own history.
    match /reports/{reportId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
